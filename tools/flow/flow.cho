edition 7;

// `flow` -- start one program as a recorded step, and write the record (docs/design.md).
//
//     flow step [--root DIR] --record DIR [--in P,P] [--out P,P] [--stdin] [--max-stdin N] [--deterministic] [--allow-failure] [--answer-output]
//               [--timeout-ms N] [--max-output N] [--format json|text] -- PROGRAM [ARG...]
//
// A step is one program from the directory baked into this binary, started with exactly these arguments, no shell and an environment
// that holds only PATH, for a bounded time. Before it starts, every file named by --in is hashed and so is the program's own file;
// after it ends, every file named by --out is hashed. The record is canonical text (`flow.canon`), a pure function of those hashes, the
// arguments, the limits and what the program did: no clock time, no duration, no host, no path outside --root, no payload. It is written
// atomically under `DIR/<id>.<oid>.json`, after the program ended and before the answer.
//
// The program-starting half is `run` of cancho-tools (tools/run/run.cho) in a new place: the same `exec_spawn_in` and
// `std.process.capture_both`, the same fixed environment, the same reading of the programs directory as the allow-list. This is the
// tool of cancho-tools' held `plan` design that the toolbox could not take (docs/design.md section 1): one more program that spawns, in
// its own repository, opt-in. It does not sandbox the program. It records what the caller declared, and cannot see a file the program
// reads or writes without being told (docs/design.md section 9).

import std.buffer;
import std.bytes;
import std.dirs;
import std.io;
import std.json;
import std.process;
import toolbox.atomic;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.out;
import toolbox.path;
import toolbox.place;
import toolbox.text;
import flow.argvp;
import flow.stepper;
import flow.canon;
import flow.config;
import flow.files;
import flow.scan;

fn flag_table() -> [] &static [byte] {
    return "root||path|root||resolve every path against this directory and refuse one outside it (default: the working directory);record||path|path-write||the directory that holds the records; it must exist beneath --root;in||text|path-read||the files the step reads, comma separated, relative to --root; each is hashed before the program starts;out||text|path-write||the files the step writes, comma separated, relative to --root; each is hashed after the program ends;stdin||bool|none||give the program this tool's standard input (hashed and recorded) as its standard input (default: nothing);stdin-file||text|path-read||a file beneath --root given to the program as its standard input (hashed and recorded as --stdin does; at most --max-stdin bytes);stdout-file||text|path-write||a file beneath --root the program's standard output is written to, atomically, after it ends (it must also be listed in --out, so it is hashed into the outcome as every output is; it is not written when the program was killed);max-stdin||nat|none|1048576|the most standard input accepted with --stdin or --stdin-file (ceiling 67108864);deterministic||bool|none||declare that the same inputs always give the same outcome: a second outcome for the same inputs is refused (default: every distinct outcome is kept);answer-output||bool|none||also put the program's standard output and standard error in the answer, as text (never in the record, which holds only their size and SHA-256);allow-failure||bool|none||a program that ends with a non-zero status is not a refusal (for a step whose job is to say no);timeout-ms||nat|none|30000|the longest the program may run, in milliseconds, after which it is killed (1 to 600000);max-output||nat|none|1048576|the most bytes kept from each of standard output and standard error, and the program is killed at the first byte past it (ceiling 67108864);format||choice:json/text|none|json|json for a record, text also writes the program's standard output to standard output and its standard error to standard error";
}

fn tool() -> [] describe.Tool {
    return describe.Tool { name: "flow", version: "0.1.0", summary: "Start one program from the deployer's programs directory as a recorded step: exact arguments, no shell, a fixed environment, a deadline and an output cap, the files it reads and writes declared and hashed, and a canonical content-addressed record written. Opt-in: it can run whatever the directory holds, it does not sandbox it, and it sees only the files it is told about.", usage: "flow step [--root DIR] --record DIR [--in P,P] [--out P,P] [--stdin | --stdin-file P] [--stdout-file P] [--max-stdin N] [--deterministic] [--allow-failure] [--answer-output] [--timeout-ms N] [--max-output N] [--format json|text] -- PROGRAM [ARG...]", output: "document", schema: "flow.v1", flags: flag_table(), operands: "VERB|name|1|1|step;PROGRAM|name|1|1|a program name in the programs directory, never a path;ARG...|text|0||the program's arguments, passed byte for byte", rules: "args.unknown-flag;args.missing-value;args.bad-value;args.unexpected-value;args.duplicate-flag;args.missing-operand;path.empty;path.dotdot;path.absolute;path.outside-root;path.too-long;path.symlink;io.not-found;io.not-a-directory;io.permission-denied;io.is-a-directory;limit.input-too-large;flow.verb;flow.program-name;flow.program-not-found;flow.spawn-failed;flow.args.not-utf8;flow.args.too-many;flow.files.too-many;flow.record.too-many;flow.record.damaged;flow.step.failed;flow.step.output-missing;flow.stdin.conflict;flow.stdout.undeclared;flow.step.not-deterministic;limit.timeout;limit.output-too-large", extra_rules: stepper.extra(), limits: "timeout-ms|30000|600000;max-output|1048576|67108864;max-stdin|1048576|67108864", reversibility: "irreversible-consequential", stdin: "with --stdin", guarantees: "bounded_memory" };
}

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

fn timeout_ceiling() -> [] int {
    return 600000;
}

fn size_ceiling() -> [] int {
    return 67108864;
}

fn flag_problem[&h](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &static [byte], hint: &static [byte], flags: &static [byte]) -> [heap] fail.Errors {
    var w = fail.open(heap, rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = json.put_key(heap, w, "flags");
    w = json.put_string(heap, w, flags);
    return fail.add(heap, e, w);
}

// A plain name: not empty, not `.` or `..`, no `/`.
fn plain_name[&n](name: &n [byte]) -> [] bool {
    if len(name) == 0 || bytes.equal(name, ".") || bytes.equal(name, "..") {
        return false;
    }
    var i = 0;
    while i < len(name) {
        if int_of(name[i]) == '/' {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn body[&h, &g, &p, &f, &x, &c, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), exec: &x Exec("/opt/cancho-flow/programs"), clock: &c Clock, io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, exec("/opt/cancho-flow/programs"), clock, poll, io_read, io_write, err_write] int {
    let table = flag_table();
    var e = errs;
    let text_mode = bytes.equal(cli.text(args, parsed, table, "format"), "text");
    let timeout = cli.nat(args, parsed, table, "timeout-ms");
    let most = cli.nat(args, parsed, table, "max-output");
    let most_in = cli.nat(args, parsed, table, "max-stdin");
    let deterministic = cli.has(parsed, table, "deterministic");
    let allow_failure = cli.has(parsed, table, "allow-failure");
    let answer_output = cli.has(parsed, table, "answer-output");
    if timeout < 1 || timeout > timeout_ceiling() {
        e = flag_problem(heap, e, "args.bad-value", "--timeout-ms is from 1 to 600000", "pass a deadline in that range", "--timeout-ms");
    }
    if most < 1 || most > size_ceiling() {
        e = flag_problem(heap, e, "args.bad-value", "--max-output is from 1 to 67108864", "pass a cap in that range", "--max-output");
    }
    if most_in > size_ceiling() {
        e = flag_problem(heap, e, "args.bad-value", "--max-stdin is above the ceiling", "67108864 is the most this tool holds", "--max-stdin");
    }
    if !cli.has(parsed, table, "record") {
        e = flag_problem(heap, e, "args.missing-operand", "step needs --record, the directory that holds the records", "flow step --record DIR [flags] -- PROGRAM [ARG...]", "--record");
    }
    let (root, after_root) = path.root(heap, args, cli.text(args, parsed, table, "root"), cli.value_index(parsed, table, "root"), e);
    e = after_root;

    // The verb, the program and its arguments.
    var name: &static [byte] = "";
    if cli.operand_count(parsed) == 0 {
        e = flag_problem(heap, e, "args.missing-operand", "flow takes a verb (step) and the PROGRAM to start", "flow step [flags] -- PROGRAM [ARG...]", "VERB");
    } else if !bytes.equal(cli.operand(args, parsed, 0), "step") {
        var w = fail.open_in(heap, stepper.extra(), "flow.verb", "the first operand is not a verb this program has", "this program has one verb, `step`; the verbs that only read are in flow-records");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        w = json.put_key(heap, w, "verb");
        w = text.put(heap, w, cli.operand(args, parsed, 0));
        e = fail.add(heap, e, w);
    } else if cli.operand_count(parsed) < 2 {
        e = flag_problem(heap, e, "args.missing-operand", "step takes the PROGRAM to start", "flow step [flags] -- PROGRAM [ARG...]", "PROGRAM");
    } else {
        name = cli.operand(args, parsed, 1);
        if !plain_name(name) {
            var w = fail.open_in(heap, stepper.extra(), "flow.program-name", "PROGRAM is a name in the programs directory, not a path", "pass the bare name, e.g. `ml`, with the arguments after it");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = json.put_key(heap, w, "program");
            w = text.put(heap, w, name);
            e = fail.add(heap, e, w);
        } else if !text.is_utf8(name) {
            e = fail.simple(heap, e, "flow.args.not-utf8", "the program name is not UTF-8", "a record holds only text", "program", name);
        }
    }
    if cli.operand_count(parsed) > config.most_args() + 2 {
        e = stepper.rule_error(heap, e, "flow.args.too-many", "more arguments than a record may hold", "a record holds at most 4096 arguments", "most", config.most_args());
    }
    var k = 2;
    while k < cli.operand_count(parsed) && k < config.most_args() + 2 {
        if !text.is_utf8(cli.operand(args, parsed, k)) {
            e = stepper.rule_error(heap, e, "flow.args.not-utf8", "an argument is not UTF-8", "a record holds only text; pass the bytes in a file named with --in", "position", k);
        }
        k = k + 1;
    }

    // The declared files, checked as lists before anything is opened.
    let in_list = cli.text(args, parsed, table, "in");
    let out_list = cli.text(args, parsed, table, "out");
    if files.elements(in_list) + files.elements(out_list) > config.most_files() {
        e = stepper.rule_error(heap, e, "flow.files.too-many", "more declared files than a record may hold", "a record holds at most 64 declared files, inputs and outputs together", "most", config.most_files());
    }

    if cli.has(parsed, table, "stdin") && cli.has(parsed, table, "stdin-file") {
        e = fail.simple(heap, e, "flow.stdin.conflict", "--stdin and --stdin-file are both given", "a step has one standard input: this tool's own (--stdin) or a file's (--stdin-file)", "", "");
    }
    var input = buffer.empty(heap, 1);
    var stdout_rel = buffer.empty(heap, 1);
    var has_stdin = cli.has(parsed, table, "stdin") || cli.has(parsed, table, "stdin-file");
    var refused = false;
    borrow e as &er in {
        refused = fail.count(er) > 0;
    }
    if !refused && cli.has(parsed, table, "stdin-file") {
        borrow root as &rt0 in {
            let (data, errno, big, rel, after) = files.read_declared(heap, fs, buffer.bytes(rt0), cli.text(args, parsed, table, "stdin-file"), most_in, e);
            e = after;
            buffer.drop(heap, input);
            input = data;
            buffer.drop(heap, rel);
            if errno > 0 {
                e = fail.io_error(heap, e, errno, false, cli.text(args, parsed, table, "stdin-file"));
            } else if big {
                e = fail.simple(heap, e, "limit.input-too-large", "the --stdin-file is larger than --max-stdin", "raise --max-stdin, up to 67108864", "", "");
            }
        }
        borrow e as &er1 in {
            refused = fail.count(er1) > 0;
        }
    }
    if !refused && cli.has(parsed, table, "stdout-file") {
        borrow root as &rt2 in {
            let (declared, after) = files.declare(heap, fs, buffer.bytes(rt2), cli.text(args, parsed, table, "stdout-file"), false, e);
            e = after;
            let files.Declared { rel, hex, size, errno } = declared;
            buffer.drop(heap, hex);
            buffer.drop(heap, stdout_rel);
            stdout_rel = rel;
        }
        borrow e as &er2 in {
            refused = fail.count(er2) > 0;
        }
    }
    if !refused && cli.has(parsed, table, "stdin") {
        buffer.drop(heap, input);
        let (read, more) = atomic.read_stdin(heap, io, most_in, buffer.empty(heap, 4096));
        input = read;
        if more {
            e = fail.simple(heap, e, "limit.input-too-large", "the standard input is larger than --max-stdin", "raise --max-stdin, up to 67108864", "", "");
            refused = true;
        }
    }

    var payload = buffer.empty(heap, 1);
    var out_text = buffer.empty(heap, 1);
    var err_text = buffer.empty(heap, 1);
    if !refused {
        borrow root as &rt in {
            // The record directory.
            let (record_at, after_record) = path.operand(heap, args, buffer.bytes(rt), cli.value_index(parsed, table, "record"), e);
            e = after_record;
            borrow record_at as &ra in {
                if path.ok(ra) {
                    match place.open_directory(fs, buffer.bytes(rt), path.shown(ra), path.full(ra)) {
                        DirOpened::Failed(errno) => {
                            e = fail.io_error(heap, e, errno, true, path.shown(ra));
                        }
                        DirOpened::Ok(opened) => {
                            var records = opened;
                            borrow records as &rd in {
                                var packed = buffer.empty(heap, 64);
                                var pk = 2;
                                while pk < cli.operand_count(parsed) {
                                    packed = argvp.add(heap, packed, cli.operand(args, parsed, pk));
                                    pk = pk + 1;
                                }
                                borrow packed as &pkb in {
                                    borrow stdout_rel as &sro in {
                                        borrow input as &ip in {
                                            let (pl, ot, et, e2) = stepper.step(heap, buffer.bytes(pkb), has_stdin, buffer.bytes(sro), fs, exec, clock, rd, buffer.bytes(rt), name, buffer.bytes(ip), in_list, out_list, deterministic, allow_failure, answer_output, timeout, most, e);
                                            buffer.drop(heap, payload);
                                            buffer.drop(heap, out_text);
                                            buffer.drop(heap, err_text);
                                            payload = pl;
                                            out_text = ot;
                                            err_text = et;
                                            e = e2;
                                        }
                                    }
                                }
                                buffer.drop(heap, packed);
                            }
                            dir_close(records);
                        }
                    }
                }
            }
            path.drop(heap, record_at);
        }
    }
    buffer.drop(heap, root);
    buffer.drop(heap, input);
    buffer.drop(heap, stdout_rel);

    var status = 0;
    borrow e as &er in {
        borrow payload as &pl in {
            borrow out_text as &ot in {
                if text_mode && fail.count(er) == 0 {
                    borrow err_text as &et in {
                        if len(buffer.bytes(et)) > 0 {
                            io.error_all(io, buffer.bytes(et));
                        }
                    }
                }
                status = out.respond(heap, io, "flow", "flow.v1", config.version(), buffer.bytes(pl), "", er, text_mode, buffer.bytes(ot), 0);
            }
        }
    }
    buffer.drop(heap, payload);
    buffer.drop(heap, out_text);
    buffer.drop(heap, err_text);
    fail.drop(heap, e);
    return status;
}

fn run[&h, &g, &f, &x, &c, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), exec: &x Exec("/opt/cancho-flow/programs"), clock: &c Clock, io: &!i Io) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, exec("/opt/cancho-flow/programs"), clock, poll, io_read, io_write, err_write] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, flag_table(), fail.empty_in(heap, stepper.extra()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, exec, clock, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    // No foreign code, no network, no signals. A clock, for the deadline only (tools.toml, [flow]); `Exec`, narrowed to the programs
    // directory.
    release(ffi);
    release(net);
    release(signals);
    let bin = narrow(exec, "/opt/cancho-flow/programs");
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow bin as &x in {
                    borrow clock as &c in {
                        borrow mut io as &!i in {
                            status = run(h, g, f, x, c, i);
                        }
                    }
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(bin);
    release(clock);
    release(io);
    return status;
}
